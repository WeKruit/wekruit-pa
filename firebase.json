{
  "firestore": {
    "rules": "config/firebase/firestore.rules",
    "indexes": "config/firebase/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "apps/functions/lib",
      "codebase": "pa-orchestrator",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "rm -rf \"$RESOURCE_DIR/../../packages/pa-orchestrator/dist\"",
        "npm --prefix \"$RESOURCE_DIR/../..\" run build --workspace=@pa/core-types --workspace=@pa/firebase-admin --workspace=@pa/agent-runtime --workspace=@pa/memory --workspace=@pa/agent-registry --workspace=@pa/pa-orchestrator",
        "node \"$RESOURCE_DIR/../scripts/predeploy-smoke.mjs\"",
        "npm --prefix \"$RESOURCE_DIR/..\" run build",
        "npm --prefix \"$RESOURCE_DIR/..\" run typecheck",
        "npm --prefix \"$RESOURCE_DIR/..\" test"
      ]
    }
  ],
  "hosting": [
    {
      "target": "pa-dashboard",
      "public": "apps/dashboard-web/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "predeploy": [
        "npm run build:all:prod"
      ],
      "redirects": [
        {
          "_comment": "v1.9 hotfix 2026-05-13 — candidate routes moved to wekruit-candidate.web.app. Firebase Hosting redirect uses `:rest*` named-capture syntax (not Netlify `:splat`). 301 preserves any stale-bookmark /j/:jobId hits.",
          "source": "/j/:rest*",
          "destination": "https://wekruit-candidate.web.app/j/:rest*",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "_comment": "iter33 spec collapse 2026-05-05 — public CTA landing page. MVP: single static index.html with sms:+13054507715 deep link. Future: pa.wekruit.com custom domain (DNS step in Firebase console).",
      "target": "pa-landing",
      "public": "apps/pa-landing/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        }
      ]
    },
    {
      "_comment": "v1.9 hotfix 2026-05-13 — Adam directive: candidate flow MUST live on its own domain (candidate.wekruit.com), NOT on the admin wekruit-pa.web.app site. apps/candidate-web is a minimal Vite app with only /j/:jobId routes. Default site URL: https://wekruit-candidate.web.app. DNS step: Adam adds CNAME candidate.wekruit.com → wekruit-candidate.web.app in Firebase console.",
      "target": "pa-candidate",
      "public": "apps/candidate-web/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "predeploy": [
        "node scripts/inject-pa-candidate-vite-env.mjs",
        "npm run build --workspace=@pa/candidate-web"
      ],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        }
      ]
    }
  ]
}
