{
  "firestore": {
    "rules": "config/firebase/firestore.rules",
    "indexes": "config/firebase/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "apps/functions/lib",
      "codebase": "pa-orchestrator",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "rm -rf \"$RESOURCE_DIR/../../packages/pa-orchestrator/dist\"",
        "npm --prefix \"$RESOURCE_DIR/../..\" run build --workspace=@pa/core-types --workspace=@pa/firebase-admin --workspace=@pa/agent-runtime --workspace=@pa/memory --workspace=@pa/agent-registry --workspace=@pa/external-supply --workspace=@pa/pa-orchestrator",
        "node \"$RESOURCE_DIR/../scripts/predeploy-smoke.mjs\"",
        "npm --prefix \"$RESOURCE_DIR/..\" run build",
        "npm --prefix \"$RESOURCE_DIR/..\" run typecheck",
        "npm --prefix \"$RESOURCE_DIR/..\" test",
        "npm --prefix \"$RESOURCE_DIR\" install --no-package-lock --production"
      ]
    }
  ],
  "hosting": [
    {
      "target": "pa-dashboard",
      "public": "apps/dashboard-web/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "predeploy": [
        "npm run build:all:prod"
      ],
      "redirects": [
        {
          "_comment": "v1.9 hotfix 2026-05-13 — candidate routes moved to pa-landing site (Adam: 'c端都在这个上面'). Maps to candidate.wekruit.com (Cloudflare CNAME). 301 from admin domain so stale-bookmark /j/:jobId hits land on the correct customer site.",
          "source": "/j/:rest*",
          "destination": "https://candidate.wekruit.com/j/:rest*",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "_comment": "v1.9 hotfix 2026-05-13 — pa-landing upgraded from static-only to Vite SPA. Now serves ALL customer-facing surfaces (Adam directive: 'c端都在这个上面'): / → Landing (preserves iter33 black-gradient design), /legal → Privacy/Terms, /j/:jobId → PublicJob (pre-screen entry), /j/:jobId/cv → PublicJobCv (legacy back-compat). Default URL https://wekruit-pa-landing.web.app. Custom domains via Cloudflare CNAMEs: candidate.wekruit.com, pa.wekruit.com both point here.",
      "target": "pa-landing",
      "public": "apps/pa-landing/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "predeploy": [
        "node scripts/inject-pa-landing-vite-env.mjs",
        "npm run build --workspace=@pa/landing"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "X-Content-Type-Options", "value": "nosniff" }
          ]
        }
      ]
    }
  ]
}
