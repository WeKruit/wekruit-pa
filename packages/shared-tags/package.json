{
  "name": "@wekruit/shared-tags",
  "version": "0.1.0",
  "private": false,
  "description": "iter30 WS2 — shared canonical-tags schema + recordTagEvent() idempotent write contract. Workspace-internal in Wave 1; GH Packages publish in Wave 2.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeKruit/wekruit-pa.git",
    "directory": "packages/shared-tags"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index-browser.js",
      "import": "./dist/index.js"
    },
    "./canonical": {
      "types": "./dist/canonical/index-browser.d.ts",
      "import": "./dist/canonical/index-browser.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "firebase-admin": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "firebase-admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "firebase-admin": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  }
}
