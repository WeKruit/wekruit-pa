{
  "name": "@pa/pa-orchestrator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pa-orchestrator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@pa/agent-registry": "0.0.1",
    "@pa/agent-runtime": "0.0.1",
    "@pa/core-types": "0.0.1",
    "@pa/firebase-admin": "0.0.1",
    "@pa/memory": "0.0.1",
    "@pa/pa-broker": "0.0.1",
    "@pa/pa-connectors": "0.0.1",
    "@pa/pa-persistence": "0.0.1",
    "@pa/pa-safety": "0.0.1",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  }
}
