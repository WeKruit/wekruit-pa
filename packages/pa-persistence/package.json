{
  "name": "@pa/pa-persistence",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@pa/core-types",
    "build": "tsc",
    "pretypecheck": "npm run build --workspace=@pa/core-types",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace=@pa/core-types",
    "test": "node --import tsx --test src/feature-flags.test.ts src/rate-limit.test.ts src/outbound-quota.test.ts src/voice-reviews.test.ts src/triggers.test.ts src/upstream-events.test.ts src/handbook.test.ts src/marketplace.test.ts src/identity.test.ts src/bulk-resume-intake.test.ts"
  },
  "dependencies": {
    "@pa/core-types": "0.0.1",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
