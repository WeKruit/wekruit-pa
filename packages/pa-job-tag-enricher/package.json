{
  "name": "@pa/job-tag-enricher",
  "version": "0.0.1",
  "private": true,
  "description": "Unified LLM job-tag enricher (mirror of pa-resume-parser, job-side). 3-tier router (gpt-5.4-nano → claude-sonnet-4-6 → gpt-4.1-mini), strict JSON schema, single shared-tags vocab.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@wekruit/shared-tags": "0.1.0",
    "openai": "^4.80.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  }
}
