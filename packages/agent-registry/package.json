{
  "name": "@pa/agent-registry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "ensure:node": "node ../../scripts/ensure-node24.mjs",
    "prebuild": "npm run ensure:node",
    "pretypecheck": "npm run ensure:node",
    "pretest": "npm run ensure:node"
  },
  "dependencies": {
    "@pa/core-types": "0.0.1",
    "@pa/pa-broker": "0.0.1",
    "firebase-admin": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": "24"
  }
}
