### Root env used by pa-orchestrator (agent runtime)
### Copy to .env and fill values. Do NOT commit secrets.

# Firebase Admin credentials (choose one)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Orchestrator settings
PA_ORCHESTRATOR_POLL_MS=2000
# PA_ORCHESTRATOR_ID=pa-orchestrator-local

# Safety / rate limits
PA_RATE_LIMIT_PER_WINDOW=20
PA_RATE_LIMIT_WINDOW_MS=60000

# LLM (required for real answers; otherwise orchestrator degrades to echo)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=...
# LITELLM_API_KEY=...
# LITELLM_BASE_URL=...
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# SILICONFLOW_API_KEY=...
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# PA_AGENT_RUNTIME=chat
# Use PA_AGENT_RUNTIME=openai_agents to route turns through the OpenAI Agents SDK.

# Optional Mem0
# MEM0_API_KEY=...
# MEM0_BASE_URL=https://api.mem0.ai/v1

# First real connector (optional; if unset, it returns ok:false with a summary)
# PA_MATCHING_URL=https://...
# PA_MATCHING_TOKEN=...

# FindX connector (optional)
# FINDX_URL=https://...
# FINDX_TOKEN=...

# v2.1 Voice Prescreen — outbound LiveKit + Twilio SIP + Deepgram
# Get values from:
#   LiveKit Cloud console (project wekruit-7v74qbl3) → API Keys → reveal secret
#   Twilio Console → Elastic SIP Trunks → wekruit-prescreen-outbound → Credential Lists
#   Deepgram Console → API Keys
#   PA_VOICE_WEBHOOK_SECRET = `openssl rand -hex 32`
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=API...
# LIVEKIT_API_SECRET=...
# TWILIO_SIP_TRUNK_SID=TK...
# TWILIO_SIP_TERMINATION_URI=tk....pstn.ashburn.twilio.com
# TWILIO_SIP_USERNAME=wekruit_outbound
# TWILIO_SIP_PASSWORD=...
# TWILIO_OUTBOUND_CALLER_IDS=+14157075057,+16468594057
# DEEPGRAM_API_KEY=...                 # used for both Nova-3 STT and Aura-2 TTS in v2.1
# PA_VOICE_WEBHOOK_SECRET=...          # random 32-char hex; also set on Twilio status-callback header X-Wekruit-Voice-Webhook-Secret
# WEKRUIT_LLM_SHIM_URL=http://localhost:8787   # S1C voice-llm-shim
# WEKRUIT_VOICE_RECORDINGS_BUCKET=wekruit-voice-recordings   # GCS bucket for LiveKit Egress
# PA_AGENT_RUNTIME_STREAM_ENABLED=false        # gates S1A runAgentTurnStream path
# PA_TCPA_GATE_ENFORCED=false                  # dev=observed; prod=blocking
# PA_VOICE_PRESCREEN_ENABLED=false             # master kill-switch for outbound voice
# Cartesia TTS deferred to v2.2 — Deepgram Aura-2 is the v2.1 TTS
