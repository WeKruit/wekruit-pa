### Root env used by pa-orchestrator (agent runtime)
### Copy to .env and fill values. Do NOT commit secrets.

# Firebase Admin credentials (choose one)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Orchestrator settings
PA_ORCHESTRATOR_POLL_MS=2000
# PA_ORCHESTRATOR_ID=pa-orchestrator-local

# Safety / rate limits
PA_RATE_LIMIT_PER_WINDOW=20
PA_RATE_LIMIT_WINDOW_MS=60000

# LLM (required for real answers; otherwise orchestrator degrades to echo)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=...
# LITELLM_API_KEY=...
# LITELLM_BASE_URL=...
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# SILICONFLOW_API_KEY=...
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# PA_AGENT_RUNTIME=chat
# Use PA_AGENT_RUNTIME=openai_agents to route turns through the OpenAI Agents SDK.

# Optional Mem0
# MEM0_API_KEY=...
# MEM0_BASE_URL=https://api.mem0.ai/v1

# First real connector (optional; if unset, it returns ok:false with a summary)
# PA_MATCHING_URL=https://...
# PA_MATCHING_TOKEN=...

# FindX connector (optional)
# FINDX_URL=https://...
# FINDX_TOKEN=...
