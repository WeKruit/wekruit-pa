rules_version = '2';
// Personal assistant platform collections — namespaced (pa-*) in shared project wekruit-5f89b.
// macOS worker uses Admin SDK and bypasses these rules.
// Dashboard: allow any signed-in user whose email is @wekruit.com, or the allowlisted address below.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    // Normalized: Google token email, compared case-insensitively
    function isPaOperator() {
      return isSignedIn()
        && request.auth.token.email is string
        && (
          request.auth.token.email.lower().matches(".*@wekruit\\.com$")
          || request.auth.token.email.lower() == "indolencorlol@gmail.com"
        );
    }
    match /pa-users/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-agents/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-sessions/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-messages/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-remote-config/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-outbound/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-inbound-events/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-agent-turns/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-tool-calls/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-audit-events/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-rate-limits/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-abuse-events/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-session-links/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-memory-events/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-beta-participants/{id} {
      allow read, write: if isPaOperator();
    }
    // Operator overview surfaces (read-only from dashboard; orchestrator writes via Admin SDK)
    match /pa-turns/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-scheduled-jobs/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-runtime-heartbeats/{id} {
      allow read, write: if isPaOperator();
    }
    // iter30/WS8 — operator-editable match weight tables (per-table doc + items subcollection).
    match /pa-match-weight-tables/{tableKey} {
      allow read, write: if isPaOperator();
      match /items/{skillKey} {
        allow read, write: if isPaOperator();
      }
    }
    // iter30/WS8 — explainer cache; cloud functions bypass via Admin SDK for writes.
    match /pa-job-rec-explanations/{id} {
      allow read, write: if isPaOperator();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
