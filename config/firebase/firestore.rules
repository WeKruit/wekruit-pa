rules_version = '2';
// Personal assistant platform collections — namespaced (pa-*) in shared project wekruit-5f89b.
// Server runtimes and Cloud Functions use Admin SDK and bypass these rules.
// Dashboard: allow any signed-in user whose email is @wekruit.com, or the allowlisted address below.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    // Normalized: Google token email, compared case-insensitively
    function isPaOperator() {
      return isSignedIn()
        && request.auth.token.email is string
        && (
          request.auth.token.email.lower().matches(".*@wekruit\\.com$")
          || request.auth.token.email.lower() == "indolencorlol@gmail.com"
        );
    }
    function hasCandidateAuthMapping() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/pa-candidate-auth/$(request.auth.uid));
    }
    function isMappedCandidate(candidateId) {
      return hasCandidateAuthMapping()
        && get(/databases/$(database)/documents/pa-candidate-auth/$(request.auth.uid)).data.candidateId == candidateId;
    }

    // ─── Core entity collections ─────────────────────────────────────
    // pa-users.source policy (2026-05-18 cleanup goal): every initial create
    // MUST stamp a canonical source label from the allowlist below. Updates
    // are not constrained so legacy docs can keep their existing field set.
    // Cloud Functions write via Admin SDK and bypass these rules — the
    // guard is defense-in-depth for direct dashboard writes only.
    match /pa-users/{id} {
      allow read: if isPaOperator();
      allow create: if request.auth != null
        && isPaOperator()
        && request.resource.data.source is string
        && request.resource.data.source in [
          "candidate",
          "WeKruit_Laid_Off",
          "admin",
          "dev_test",
          "e2e_run",
          "qa_run",
          "external_supply"
        ];
      allow update, delete: if isPaOperator();
    }
    match /pa-agents/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-agent-versions/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-sessions/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-messages/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-message-archives/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-conversation-summaries/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-session-links/{id} {
      allow read, write: if isPaOperator();
    }

    // ─── Inbound / outbound / events ─────────────────────────────────
    match /pa-inbound-events/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-outbound/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-tool-calls/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-audit-events/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-rate-limits/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-abuse-events/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-surprise-events/{id} {
      allow read, write: if isPaOperator();
    }

    // ─── Turns / scheduled / heartbeats (Operator overview) ──────────
    match /pa-turns/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-agent-turns/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-scheduled-jobs/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-runtime-heartbeats/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-worker-cursors/{id} {
      allow read, write: if isPaOperator();
    }

    // ─── Memory subsystem ────────────────────────────────────────────
    match /pa-memory-events/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-memory-actions/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-memory-facts/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-memory-profiles/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-memory-evolution-events/{id} {
      allow read, write: if isPaOperator();
    }

    // ─── Handbook + personas + playbooks (configurable behavior) ─────
    match /pa-handbooks/{slug} {
      allow read, write: if isPaOperator();
      match /versions/{v} {
        allow read, write: if isPaOperator();
      }
    }
    match /pa-personas/{id} {
      allow read, write: if isPaOperator();
      match /versions/{v} {
        allow read, write: if isPaOperator();
      }
    }
    // iter33 spec collapse 2026-05-05 — onboarding prompt config (pa-onboarding-config/v1).
    // Edited via /admin/onboarding dashboard; orchestrator reads with 30s TTL cache.
    match /pa-onboarding-config/{id} {
      allow read, write: if isPaOperator();
    }
    // iter34 P3 — Q-as-class registry (pa-onboarding-questions/{qId}).
    // Read by orchestrator pipeline, surfaced via /admin/onboarding-questions
    // dashboard for Adam to verify Q config without code redeploy.
    match /pa-onboarding-questions/{qId} {
      allow read, write: if isPaOperator();
    }
    // Practice interview question bank for Claire-ready cases. Operator-only:
    // candidates must never read source answers, rubrics, or archived rows.
    match /pa-practice-question-bank/{questionId} {
      allow read, write: if isPaOperator();
    }
    // Canonical screening-eval artifacts. Operators can review; writes go
    // through Admin SDK/callables so eval cannot mutate employment state from
    // browser clients.
    match /pa-evaluation-attempts/{attemptId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-playbooks/{key} {
      allow read, write: if isPaOperator();
      match /versions/{v} {
        allow read, write: if isPaOperator();
      }
      match /audit/{id} {
        allow read, write: if isPaOperator();
      }
    }

    // ─── Feature flags + remote config ───────────────────────────────
    match /pa-feature-flags/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-remote-config/{id} {
      allow read, write: if isPaOperator();
    }

    // ─── Triggers (upstream + downstream) ────────────────────────────
    match /pa-upstream-templates/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-downstream-triggers/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-trigger-fires/{id} {
      allow read, write: if isPaOperator();
    }

    // ─── Beta + voice eval ───────────────────────────────────────────
    match /pa-beta-participants/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-voice-eval-runs/{id} {
      allow read, write: if isPaOperator();
    }
    match /pa-voice-reviews/{id} {
      allow read, write: if isPaOperator();
    }
    // v2.2 W6 — admin voice-test-dial form subscribes to booking docs
    // via Firestore onSnapshot to show live voiceState. Server CFs write
    // these via Admin SDK; dashboard only reads.
    match /outbound-bookings/{id} {
      allow read: if isPaOperator();
    }

    // ─── iter30/WS8 — match weights + explainer ──────────────────────
    match /pa-match-weight-tables/{tableKey} {
      allow read, write: if isPaOperator();
      match /items/{skillKey} {
        allow read, write: if isPaOperator();
      }
      match /audit/{id} {
        allow read, write: if isPaOperator();
      }
    }
    match /pa-job-rec-explanations/{id} {
      allow read, write: if isPaOperator();
    }

    // ─── iter30/WS2 — tag pipeline (canonical + events + entity) ─────
    match /pa-canonical-tags/{tagKey} {
      allow read, write: if isPaOperator();
    }
    match /pa-tag-events/{eventId} {
      allow read, write: if isPaOperator();
    }
    match /pa-entity-tags/{entityId} {
      allow read, write: if isPaOperator();
      match /items/{tagKey} {
        allow read, write: if isPaOperator();
      }
    }
    match /pa-alerts/{id} {
      allow read, write: if isPaOperator();
    }

    // ─── pa-companies (employer org docs + Phase A3 directory) ───
    // Operator R/W for editing; CFs bypass via Admin SDK. Read powers
    // /admin/external-supply/jobs company browser + /admin/companies (A4);
    // write is admin-only. Phase A3 NOTE: spec called for public read but
    // collection contains sensitive employer competitor lists / school
    // prefs from v2.0 external-supply — keep operator-only. Score-time
    // V16 reads (apps/job-rec/src/lib/load-companies.ts B5) go through
    // Admin SDK which bypasses rules.
    match /pa-companies/{companyId} {
      allow read: if isPaOperator();
      allow write: if isPaOperator();
    }

    // ─── layoff_employers (WeKruit Open employer signups) ────────────
    // Written by openRegisterEmployer (Admin SDK, bypasses rules) when an
    // employer submits the /employer form on layoff.wekruit.com. Operator
    // R/W for the /admin/layoff-employers dashboard so ops can review
    // pending signups and flip verificationStatus → "verified" (which is
    // what runListLayoffCandidates checks before exposing the talent list).
    match /layoff_employers/{employerId} {
      allow read: if isPaOperator();
      allow write: if isPaOperator();
    }

    // ─── Phase A5 — enrichment cascade source caches ───────────────
    // YC company directory snapshot + Clearbit quota counter. Written
    // exclusively by paEnrichCompaniesNightly / paEnrichCompaniesAdHoc
    // (Admin SDK, bypasses rules); operator read only for debugging.
    match /pa-companies-source/{docId} {
      allow read: if isPaOperator();
      allow write: if false;
    }

    // ─── v1.8 Phase 78 / v1.9 Phase 87 — pa-jobs (employer-authored config) ─
    // Operator R/W for editor; CFs bypass via Admin SDK.
    // v1.9 P87: public read when resource.data.publicVisible === true so
    // /j/:jobId can render outside the auth wall. Write still operator-only.
    match /pa-jobs/{jobId} {
      allow read: if isPaOperator() || resource.data.publicVisible == true;
      allow write: if isPaOperator();

      // v2.0 S4 — generated job enrichment drafts are admin review state.
      // Dashboard reads them; all client writes must go through callables.
      match /enrichment/{draftId} {
        allow read: if isPaOperator();
        allow write: if false;
      }

      // v2.0 S4 — eval fixtures may contain unpublished HITL/debug evidence.
      match /enrichment-eval-fixtures/{fixtureId} {
        allow read: if isPaOperator();
        allow write: if false;
      }
    }

    // ─── v1.8 Phase 74.5 + 79 — Memory compaction + tag snapshots ────
    // PS13: pre-compaction snapshots of pa-users.{uid}.tags. Server-write
    // only (Cloud Functions); operator-read for rollback UI. Candidates
    // (non-operator users) cannot read.
    match /pa-users-tag-snapshots/{uid}/snapshots/{snapId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    // PS14: compaction cost ledger. Operator read-only; CF writes via Admin.
    match /pa-compaction-cost-ledger/{entryId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    // PS15: pre-screen sessions + per-turn evaluation explanations.
    // Server-write only — Cloud Function owns writes. Candidate identity
    // never reads — explanation fields are server-only.
    match /pa-prescreen-sessions/{sessionId} {
      allow read: if isPaOperator();
      allow write: if false;
      match /turns/{turnId} {
        allow read: if isPaOperator();
        allow write: if false;
      }
    }
    // Phase 77 idempotency stamps for the prescreen trigger (60-min window).
    match /pa-prescreen-trigger-idempotency/{pairKey} {
      allow read, write: if isPaOperator();
    }
    // Phase 79 rollback audit trail.
    match /pa-tag-rollback-events/{eventId} {
      allow read: if isPaOperator();
      allow write: if isPaOperator();
    }
    // Phase 75 fixture corpus for the KeywordSet drift detector.
    match /pa-prescreen-fixtures/{fixtureId} {
      allow read, write: if isPaOperator();
    }
    // Phase 75 nightly drift run audit.
    match /pa-prescreen-drift-runs/{runId} {
      allow read: if isPaOperator();
      allow write: if false;
    }

    // ─── v1.9 Phase 85 — Apply trigger idempotency ───────────────────
    match /pa-apply-trigger-idempotency/{pairKey} {
      allow read, write: if isPaOperator();
    }
    // ─── v1.9 Phase 85 — PII confirm pipeline state ──────────────────
    match /pa-pii-confirm-state/{userId} {
      allow read, write: if isPaOperator();
    }
    // ─── v1.9 Phase 86 — ATS inbound mapping + idempotency ───────────
    match /pa-jobs-external-mapping/{key} {
      allow read, write: if isPaOperator();
    }
    match /pa-ats-invite-idempotency/{key} {
      allow read, write: if isPaOperator();
    }
    // ─── v1.9 G2 — ATS pending-trigger virtualization (24h TTL) ─────
    // Stamped by paAtsInboundWebhook when invite SMS sent; consumed by
    // paSendblueWebhook on candidate's first non-trigger reply.
    match /pa-ats-pending-trigger/{phoneE164} {
      allow read, write: if isPaOperator();
    }
    // ─── v1.9 Phase 87 + G4 — Public job page pending invites ───────
    // Public-create allowed (anyone can claim a UUID-keyed slot for their
    // job-page visit). Limited size + required fields enforced. Updates +
    // reads operator-only — server consumes the doc on first inbound and
    // writes attribution to pa-users.{uid}.attribution.
    match /pa-prescreen-pending-invites/{requestedUserId} {
      allow read: if isPaOperator();
      allow create: if
        request.resource.data.jobId is string
        && request.resource.data.requestedUserId is string
        && request.resource.data.createdAt is string
        && request.resource.data.size() <= 6;
      allow update, delete: if isPaOperator();
    }
    // ─── v1.9 Phase 88 — Sendblue pool config + others ───────────────
    // pa-config/sendblue-pool is read by the public /j/:jobId page so the
    // candidate's outbound first SMS lands on the same pool number the
    // server-side selector will pick for replies (thread continuity).
    // Numbers are NOT secret — candidates see them anyway when SMSing.
    // All other pa-config docs (and writes anywhere) remain operator-only.
    match /pa-config/{configId} {
      allow read: if configId == "sendblue-pool" || isPaOperator();
      allow write: if isPaOperator();
    }

    // ─── matching-jobs — macmini-scraped marketplace pool ───────────
    // Powers candidate.wekruit.com/market (Direct line + Hunting list).
    // Public read constrained to status=="active"; client further filters
    // dead/missing-url. Writes go through CFs (Admin SDK) only.
    // No PII in these docs — only public job postings + company metadata.
    match /matching-jobs/{jobId} {
      allow read: if resource.data.status == "active" || isPaOperator();
      allow write: if false;
    }

    // ─── pa-public-jobs — marketing site (wekruit.com) "Open jobs Claire
    // can fast-track" list. Reads filter where active==true. Public listing
    // is the entire purpose of the collection. Write operator-only.
    match /pa-public-jobs/{jobId} {
      allow read: if resource.data.active == true || isPaOperator();
      allow write: if isPaOperator();
    }
    // pa-job-clicks — anonymous click-tracking from marketing site. Anyone
    // may create a click record (write-only telemetry); read operator-only.
    match /pa-job-clicks/{clickId} {
      allow create: if true;
      allow read: if isPaOperator();
      allow update, delete: if isPaOperator();
    }

    // ─── v2.0 S1 — marketplace data foundation ─────────────────────
    // S1 is admin/operator visibility plus server-owned state writes. Future
    // candidate claim reads belong to S2 after identity is locked.
    match /pa-candidate-handles/{id} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-resume-artifacts/{id} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    // Legacy parsed resume rows are server-written by CV ingest and are the
    // source of truth for admin-only work-history inspection.
    match /parsedCandidateResumes/{id} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-candidate-job-states/{id} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-candidate-job-matches/{id} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-outbound-invites/{id} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-employer-visible-profiles/{id} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-feedback-events/{id} {
      allow read, create: if isPaOperator();
      allow update, delete: if false;
    }
    match /pa-correction-events/{id} {
      allow read, create: if isPaOperator();
      allow update, delete: if false;
    }

    // ─── v2.0 S2 — candidate claim identity layer ───────────────────
    // Raw pa-users remains operator-only above. Candidates may read only their
    // own auth mapping and the redacted self-profile selected by that mapping.
    // Identity internals stay operator-only; server writes via Admin SDK.
    match /pa-candidate-auth/{firebaseUid} {
      allow read: if isPaOperator() || (isSignedIn() && firebaseUid == request.auth.uid);
      allow write: if false;
    }
    match /pa-candidate-self-profiles/{candidateId} {
      allow read: if isPaOperator() || isMappedCandidate(candidateId);
      allow write: if false;
    }
    match /pa-candidate-identity-events/{id} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-candidate-identity-conflicts/{id} {
      allow read: if isPaOperator();
      allow write: if false;
    }

    // ─── v2.0 S3 — admin/operator bulk resume intake ────────────────
    // Supply intake is not candidate-facing. Operators manage batch review
    // state from the admin dashboard; Cloud Functions write through Admin SDK.
    match /pa-bulk-upload-batches/{batchId} {
      allow read: if isPaOperator();
      allow write: if false;
      match /items/{itemId} {
        allow read: if isPaOperator();
        allow write: if false;
      }
    }

    // ─── v2.0 external-supply V1 — operator-only intake/eval/outreach ───
    // Internal admin dashboard reads these directly. All mutations route
    // through admin-gated Cloud Functions via Admin SDK (bypasses rules).
    // Candidate / public clients must never see external-supply data.
    match /pa-external-sourcing-batches/{batchId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-external-candidate-records/{recordId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-candidate-source-links/{sourceLinkId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-candidate-evaluation-runs/{runId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-candidate-company-job-evaluations/{evaluationId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-agent-research-tasks/{taskId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-outreach-plans/{planId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-instantly-sync-records/{syncId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-mailgun-sync-records/{syncId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-outreach-events/{eventId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-source-quality-metrics/{metricId} {
      allow read: if isPaOperator();
      allow write: if false;
    }

    // ─── Recruiter platform ──────────────────────────────────────────
    // Cloud Functions own invite-code binding and notification writes. Operators can
    // inspect recruiter access state and update submission feedback/status.
    match /pa-recruiter-invite-codes/{inviteCodeId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-recruiter-users/{recruiterUid} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-recruiter-submissions/{submissionId} {
      allow read, update: if isPaOperator();
      allow create, delete: if false;
    }
    match /pa-recruiter-role-applications/{applicationId} {
      allow read, update: if isPaOperator();
      allow create, delete: if false;
    }
    match /pa-recruiter-sourced-candidates/{candidateId} {
      allow read, update: if isPaOperator();
      allow create, delete: if false;
    }
    match /pa-recruiter-role-feedback/{feedbackId} {
      allow read: if isPaOperator();
      allow write: if false;
    }
    match /pa-recruiter-role-questions/{questionId} {
      allow read, update: if isPaOperator();
      allow create, delete: if false;
    }
    match /pa-recruiter-notifications/{notificationId} {
      allow read: if isPaOperator();
      allow write: if false;
    }

    // ─── Default deny ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
