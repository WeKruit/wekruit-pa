rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Recruiter resume uploads — authenticated recruiters can write to their own path
    match /recruiter-submissions/{jobId}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }
  }
}
