rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Recruiter resume uploads — authenticated recruiters can write to their own path
    match /recruiter-submissions/{jobId}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Admin bulk résumé intake stores originals here and references them from
    // pa-recruiter-submissions.candidate.resumeUrl as gs:// URIs.
    match /pa-bulk-resumes/{batchId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
