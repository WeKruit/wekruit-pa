# Firebase Cloud Functions Gen2 runtime env (NON-SECRET).
# Copy to `apps/functions/.env` (gitignored) and edit. The build step
# (`apps/functions/build.mjs`) copies `.env` into `lib/` so firebase-tools
# loads it at deploy time.
#
# Secrets (SILICONFLOW_API_KEY, QDRANT_URL, QDRANT_API_KEY) are bound via
# `defineSecret` in src/index.ts and managed by `firebase functions:secrets:*`.
# Do NOT put secrets in this file.

# Voice v1: set to "true" to disable the post-history reminder in orchestrator. Omit or use false to keep on.
# PA_VOICE_V1_DISABLED=false

# Phase 11.3 — Mem0/Qdrant partition key. Default behavior (unset or any value
# other than "false") routes Mem0 read/write through `resolveMem0PartitionKey`
# (user.mem0UserId ?? user.id). Set to "false" for the identity-mode rollback
# (forces Mem0 to key on user.id only) — incident-grade kill switch, no redeploy.
# PA_MEM0_USE_PARTITION_KEY=true

# Memory-opt — Mem0 search top-K rerank via small-LLM. Default ON when
# unset. Set to "true" to disable the rerank step (top-K cosine ordering
# wins). Leave OFF unless cost or latency regression observed.
# PA_MEM0_RERANK_DISABLED=false

# Comma-separated list of pa_users/{id} UUIDs that are allowed to trigger
# the in-band test admin magic strings (__PA_RESET__, /pa-reset,
# 重置我的记忆) without needing pa_users/{id}.testMode === true preset.
# First successful invocation auto-flips testMode = true on the user record.
#
# Leave empty in production. Add the test-user UUID(s) for dev/staging.
PA_ADMIN_USER_IDS=

# Optional CSV of admin E.164 (or US 10-digit): grants same privileges as the
# UUID allowlist above for magic reset + __PA_FIND_MATCH__ (last-10-digit match vs inbound phone).
PA_ADMIN_PHONES=

# ── Phase 24 — Voice Rewriter v2 (T1C) ──────────────────────────────────
# Default rewriter model (SiliconFlow free tier).
# Swap to Qwen/Qwen3.5-4B once SiliconFlow adds it to their catalog
# (target as of 24-RESEARCH.md 2026-04-27 — currently 404s on SF).
PA_LLM_REWRITE_MODEL=Qwen/Qwen3-8B
PA_LLM_REWRITE_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct

# SiliconFlow base URL (rewriter inherits from OPENAI_BASE_URL chain;
# set explicitly for clarity).
PA_LLM_REWRITE_BASE_URL=https://api.siliconflow.cn/v1

# SiliconFlow API key (provisioned in GCP Secret Manager as SILICONFLOW_API_KEY;
# mapped to OPENAI_API_KEY in functions runtime — already wired).

# Rollback flag — set to "true" to bypass the rewriter and ship raw nano output.
# PA_LLM_REWRITE_DISABLED=true
