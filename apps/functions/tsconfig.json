{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "paths": {
      "@wekruit/shared-tags": ["../../packages/shared-tags/dist/index.d.ts"],
      "@wekruit/shared-tags/*": ["../../packages/shared-tags/dist/*.d.ts"],
      "zod4-agent-sdk": ["../../node_modules/zod/index.d.cts"]
    }
  },
  "include": ["src/**/*.ts"]
}
