# Copy to a path OUTSIDE git (or Infisical secret file) with real values.
# Point PA_DASHBOARD_VITE_ENV_FILE at it for production builds, e.g.:
#   export PA_DASHBOARD_VITE_ENV_FILE=$HOME/.config/wekruit/pa-dashboard-vite.env
#   npm run deploy:hosting
#
# Or: infisical run -- npm run deploy:hosting   (with VITE_* in that environment)

