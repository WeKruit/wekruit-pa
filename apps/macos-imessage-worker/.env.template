### Mac iMessage worker (channel adapter)
### Copy to .env and fill values. Do NOT commit secrets.

# Must be enabled for real platform mode
USE_PLATFORM_FIREBASE=1

# Broker mode: primary = adapter-only (creates pa_inbound_events + sends pa_outbound)
PA_BROKER_MODE=primary

# Health endpoint for dashboard status
PA_HEALTH_PORT=8787
# PA_HEALTH_BIND=127.0.0.1

# Polling is the stable local inbound path on macOS schemas where Photon watcher queries unavailable columns.
PA_IMESSAGE_WATCH_MODE=poll
# PA_IMESSAGE_POLL_MS=2000

# Firebase Admin credentials (choose one)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional allowlist for inbound DMs
# IMESSAGE_DM_ALLOWLIST=1
# IMESSAGE_PEER=+1...

# Optional iMessage session key strategy
# PA_IMESSAGE_SESSION_KEY=chatid

# Worker does NOT need OPENAI/MEM0 in brokered primary mode.

# Phase 15 — chunked-message simulation kill switch.
# Default = true (DISABLED). Worker delivers each reply as a single
# message, identical to pre-Phase-15 behavior. Set to "false" to
# enable chunked delivery (2-3 chunks with 800-1500ms gaps for replies
# longer than 60 chars). P10 will flip this default after telemetry.
PA_TYPING_INDICATOR_DISABLED=true
