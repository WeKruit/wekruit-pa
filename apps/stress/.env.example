# Artillery stress harness — STAGING ONLY. Never set these to prod values.
# Copy to apps/stress/.env and load via `dotenv` if running locally.

# Sendblue inbound webhook URL on staging (the public CF endpoint that
# Sendblue posts to). Format: https://us-central1-<staging-project>.cloudfunctions.net/paSendblueInbound
STAGING_SENDBLUE_WEBHOOK_URL=

# HMAC secret used by the staging Sendblue webhook to verify signatures.
# Mirrors `SENDBLUE_API_SECRET_KEY` on staging.
STAGING_SENDBLUE_HMAC_SECRET=

# pa-upstream webhook URL + HMAC secret (Phase 31 T2).
# Format: https://us-central1-<staging-project>.cloudfunctions.net/paUpstreamEventWebhook
STAGING_UPSTREAM_WEBHOOK_URL=
STAGING_UPSTREAM_HMAC_SECRET=

# Admin endpoint for downstream-fire (per-turn evaluation trigger).
STAGING_DOWNSTREAM_TRIGGER_URL=

# Test phone number routed to a staging-allowlisted recipient. NEVER a real
# user's number. Provision a fresh Sendblue test line for this.
STAGING_TEST_PHONE_NUMBER=+15555550100

# Bearer token for admin actions on staging. Rotate after each stress run.
ADMIN_TOKEN=
