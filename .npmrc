# iter32 deploy-fix 2026-05-04 — pnpm v10 defaults `link-workspace-packages`
# to false, but this monorepo declares workspace deps via plain version
# strings (e.g. `"@pa/pa-orchestrator": "0.0.1"`) instead of the
# `workspace:*` protocol. Setting this to `true` tells pnpm to resolve
# matching version strings as workspace links so esbuild can find them
# when bundling apps/functions and apps/dashboard-web.
#
# Without this flag CI ran `pnpm install --frozen-lockfile` and got an
# install that "succeeded" but didn't link workspace packages into
# apps/functions/node_modules — esbuild then died with
# "Could not resolve '@pa/pa-orchestrator'".
link-workspace-packages=true
auto-install-peers=true

# Project runtime is Node 24. Fail dependency installs immediately if the shell
# leaks another major version (most commonly Homebrew Node 25 in nested dirs).
engine-strict=true
