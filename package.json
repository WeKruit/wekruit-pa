{
  "name": "personal-assistant-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "firebase-tools": "15.3.1"
  },
  "scripts": {
    "build": "npm run build --workspace=@pa/core-types --workspace=@pa/firebase-admin --workspace=@pa/pa-persistence --workspace=@pa/pa-broker --workspace=@pa/pa-safety --workspace=@pa/agent-runtime --workspace=@pa/pa-connectors --workspace=@pa/memory --workspace=@pa/agent-registry --workspace=@pa/pa-orchestrator",
    "orchestrator": "npm run start --workspace=@pa/pa-orchestrator",
    "build:all": "npm run build && npm run build --workspace=@pa/dashboard-web",
    "build:dashboard:with-injected-env": "node scripts/inject-pa-dashboard-vite-env.mjs && npm run build --workspace=@pa/dashboard-web",
    "build:all:prod": "npm run build && npm run build:dashboard:with-injected-env",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "node --test tests/scenarios/runner.test.mjs && node scripts/run-scenarios-if-env.mjs && npm run test -ws --if-present",
    "eval": "PA_RUN_EVAL=1 node tests/scenarios/runner.mjs tests/scenarios/scenarios/",
    "probe:model": "node scripts/probe-pa-model.mjs",
    "seed:agents": "npm run build --workspace=@pa/agent-registry && node scripts/pa-push-seed-agents.mjs",
    "seed:agents:apply": "npm run build --workspace=@pa/agent-registry && node scripts/pa-push-seed-agents.mjs --apply",
    "sync-pa-vite:firebase": "node scripts/fetch-pa-dashboard-vite-from-firebase.mjs",
    "deploy:hosting:from-firebase": "node scripts/deploy-pa-hosting-from-firebase.mjs",
    "deploy:hosting": "firebase deploy --only hosting:pa-dashboard --project wekruit-5f89b --non-interactive",
    "deploy:hosting:infisical": "bash scripts/deploy-pa-hosting-with-infisical.sh",
    "deploy:hosting:firestore": "firebase deploy --only hosting:pa-dashboard,firestore:rules,firestore:indexes --project wekruit-5f89b --non-interactive",
    "test:voice": "cd apps/eval/voice && PA_RUN_EVAL=1 deepeval test run test_voice_baseline.py -n 4",
    "test:voice:anchors": "cd apps/eval/voice && PA_RUN_EVAL=1 deepeval test run test_voice_baseline.py -k regression-anchor"
  }
}
